# ==========================================
# Fake News Detection - Git Ignore
# ==========================================

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Datasets
data/
datasets/

# Trained models / large model files
models/
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.keras
*.pt
*.pth
*.onnx
*.safetensors
*.bin

# Temporary/generated outputs
outputs/
logs/
*.log

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# VS Code
.vscode/

# Python packaging
build/
dist/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.bak